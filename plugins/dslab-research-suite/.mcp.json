{
  "mcpServers": {
    "arxiv-mcp-server": {
      "command": "uv",
      "args": [
        "tool",
        "run",
        "arxiv-mcp-server",
        "--storage-path",
        "${HOME}/.arxiv-mcp-server/papers"
      ]
    },
    "paper-search-mcp": {
      "command": "uv",
      "args": [
        "tool",
        "run",
        "paper-search-mcp"
      ]
    }
  }
}
